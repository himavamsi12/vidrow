      <div class="hx-step hx-s1 hx-y" data-g="0">
        <span class="hx-stat">2x - 10x</span>
        <span class="hx-note">Increase in ad spends without CAC increase</span>
      </div>
      <div class="hx-step hx-s3 hx-y" data-g="2">
        <span class="hx-tag">REPEATABLE<br>GROWTH<br>ENGINE</span>
      </div>
      <div class="hx-step hx-s2 hx-v" data-g="1">
        <span class="hx-stat">5x - 10x</span>
        <span class="hx-note">Increase in ad spends without CAC increase</span>
      </div>
      <div class="hx-step hx-s4 hx-v" data-g="3">
        <span class="hx-tag">SPEED THAT<br>COMPOUNDS</span>
      </div>
    </div>

    <div class="hx-copy">
      <h1 class="hx-h"><u class="hx-w" data-i="0">Marketing</u> <u class="hx-w" data-i="1">Partner</u>&nbsp; behind<br>Fastest <u class="hx-w" data-i="2">Growing</u> <u class="hx-w" data-i="3">Startups.</u></h1>
      <p class="hx-sub">We work alongside founders to turn marketing into a clearer, faster and more repeatable path to growth.</p>
      <a class="hx-cta" href="#contact">
        <span class="hx-cta-t">Click to grow</span>
        <span class="hx-cta-i" aria-hidden="true"><svg viewBox="0 0 40 40" aria-hidden="true"><g fill="#715BE4"><rect x="10" y="10" width="6" height="6"/><rect x="17" y="10" width="6" height="6"/><rect x="24" y="10" width="6" height="6"/><rect x="17" y="17" width="6" height="6"/><rect x="24" y="17" width="6" height="6"/><rect x="24" y="24" width="6" height="6"/></g></svg></span>
      </a>
    </div>

  </div>
</header>

<!-- ══ FEATURED WORK ══ -->
<section class="fw" id="featured">
  <div class="fw-in">
    <div class="fw-head rv">
      <div class="fw-tagwrap">
        <span class="fw-tag">Featured work</span>
        <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
