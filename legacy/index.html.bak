      <span class="vfoot__piece" style="--x:16;--y:0;--w:2;--h:4;--fall:18.80;--at:1591ms;--dur:643ms;--uat:3728ms;--c:var(--shade-c)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i><i style="--x:0;--y:2"></i><i style="--x:1;--y:2"></i><i style="--x:1;--y:3"></i></span></span>
      <span class="vfoot__piece" style="--x:25;--y:0;--w:2;--h:3;--fall:17.80;--at:1675ms;--dur:625ms;--uat:3487ms;--c:var(--shade-a)"><span class="vfoot__pieceIn"><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i><i style="--x:0;--y:2"></i><i style="--x:1;--y:2"></i></span></span>
      <span class="vfoot__piece" style="--x:30;--y:0;--w:3;--h:3;--fall:17.80;--at:1759ms;--dur:625ms;--uat:3524ms;--c:var(--shade-d)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i><i style="--x:2;--y:1"></i><i style="--x:2;--y:2"></i></span></span>
      <span class="vfoot__piece" style="--x:18;--y:1;--w:3;--h:2;--fall:17.80;--at:1842ms;--dur:625ms;--uat:3554ms;--c:var(--shade-a)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i><i style="--x:1;--y:1"></i><i style="--x:2;--y:1"></i></span></span>
      <span class="vfoot__piece" style="--x:33;--y:0;--w:2;--h:3;--fall:17.80;--at:1926ms;--dur:625ms;--uat:3587ms;--c:var(--shade-a)"><span class="vfoot__pieceIn"><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i><i style="--x:0;--y:2"></i><i style="--x:1;--y:2"></i></span></span>
      <span class="vfoot__piece" style="--x:13;--y:1;--w:2;--h:2;--fall:17.80;--at:2010ms;--dur:625ms;--uat:3597ms;--c:var(--shade-a)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i></span></span>
      <span class="vfoot__piece" style="--x:28;--y:0;--w:4;--h:3;--fall:17.80;--at:2094ms;--dur:625ms;--uat:3719ms;--c:var(--shade-c)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i><i style="--x:2;--y:1"></i><i style="--x:3;--y:1"></i><i style="--x:3;--y:2"></i></span></span>
      <span class="vfoot__piece" style="--x:22;--y:0;--w:2;--h:2;--fall:16.80;--at:2178ms;--dur:607ms;--uat:3517ms;--c:var(--shade-a)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i></span></span>
      <span class="vfoot__piece" style="--x:11;--y:1;--w:2;--h:1;--fall:16.80;--at:2261ms;--dur:607ms;--uat:3574ms;--c:var(--shade-c)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i></span></span>
      <span class="vfoot__piece" style="--x:23;--y:0;--w:3;--h:2;--fall:16.80;--at:2345ms;--dur:607ms;--uat:3601ms;--c:var(--shade-b)"><span class="vfoot__pieceIn"><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i></span></span>
      <span class="vfoot__piece" style="--x:3;--y:0;--w:2;--h:2;--fall:16.80;--at:2429ms;--dur:607ms;--uat:3708ms;--c:var(--shade-c)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:0;--y:1"></i><i style="--x:1;--y:1"></i></span></span>
      <span class="vfoot__piece" style="--x:6;--y:0;--w:3;--h:1;--fall:15.80;--at:2512ms;--dur:589ms;--uat:3483ms;--c:var(--shade-c)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i></span></span>
      <span class="vfoot__piece" style="--x:18;--y:0;--w:3;--h:1;--fall:15.80;--at:2596ms;--dur:589ms;--uat:3622ms;--c:var(--shade-d)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i></span></span>
      <span class="vfoot__piece" style="--x:10;--y:0;--w:4;--h:1;--fall:15.80;--at:2680ms;--dur:589ms;--uat:3713ms;--c:var(--shade-b)"><span class="vfoot__pieceIn"><i style="--x:0;--y:0"></i><i style="--x:1;--y:0"></i><i style="--x:2;--y:0"></i><i style="--x:3;--y:0"></i></span></span>
  </div>
</footer>

<script>
(function () {
  "use strict";

  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── the levers: one cube, six pieces ──────────────────────────
     Cell coordinates and fills are lifted straight from Cube.svg, so
     the assembled block is the artwork exactly — including the 4px
     daylight the file leaves between pieces. --------------------- */

  var CUBE_W = 404;                       // 4 x 4 of 100-unit cells, plus the seams
  var CUBE_PX = 280;                      // how wide the assembled block sits on screen
  var PIECES = [
    { lever: "Performance", copy: "Scientific media buying across Meta, Google &amp; niche networks.",
      cells: [[-1.4,-1.4,100,100,"#F5F25D"],[98.6,-1.4,100,100,"#F5F25D"],[-1.4,98.6,100,100,"#FFE41C"],[98.6,98.6,100,100,"#FEF7AD"]] },
    { lever: "Brand", copy: "Developing narratives that stick in the modern consumer’s mind.",
      cells: [[201.2,-1.6,100,100,"#F5F25D"],[301.2,-1.6,100,100,"#F5F25D"],[201.2,98.4,100,100,"#FFE41C"]] },
    { lever: "Celebrity", copy: "High-impact influencer and celebrity collaborations that convert.",
      cells: [[302.0,100.3,100,100,"#947AF0"],[202.0,200.3,100,100,"#7253E1"],[302.0,200.3,100,100,"#8B6FEE"]] },
    { lever: "Social", copy: "Organic &amp; community growth strategies for sustained engagement.",
      cells: [[-1.8,200.9,100,100,"#7253E1"],[98.2,200.9,100,100,"#947AF0"]] },
    { lever: "AdOps", copy: "Full-stack technical measurement and funnel optimization.",
      cells: [[-1.1,301.7,100,100,"#F5F25D"],[98.9,301.7,100,100,"#FEF7AD"]] },
    { lever: "AI", copy: "Automated creative testing and predictive growth modeling.",
      cells: [[201.1,301.7,100,100,"#7253E1"],[301.1,301.7,100,100,"#947AF0"]] }
  ];

  var levTrack = document.getElementById("levTrack");
  var levStage = document.getElementById("levStage");
  var levCubes = document.getElementById("levCubes");
  var levSec   = document.getElementById("levers");
  var levA  = document.querySelector(".lev-a");
  var levB  = document.querySelector(".lev-b");
  var levHy = document.querySelector(".lev-hy");
  var levEyebrow = document.getElementById("levEyebrow");

  function colHTML(pc) {
    return '<div class="lev-col"><span class="lev-slot" aria-hidden="true"></span>' +
           '<h3>' + pc.lever + '</h3><p>' + pc.copy + '</p></div>';
  }
  document.getElementById("levRowTop").innerHTML = PIECES.slice(0, 3).map(colHTML).join("");
  document.getElementById("levRowBot").innerHTML = PIECES.slice(3).map(colHTML).join("");

  var levCols  = [].slice.call(document.querySelectorAll(".lev-col"));
  var levSlots = [].slice.call(document.querySelectorAll(".lev-slot"));

  var CELLS = [];
  PIECES.forEach(function (pc, pi) {
    pc.minX = Math.min.apply(null, pc.cells.map(function (c) { return c[0]; }));
    pc.minY = Math.min.apply(null, pc.cells.map(function (c) { return c[1]; }));
    pc.h    = Math.max.apply(null, pc.cells.map(function (c) { return c[1] + c[3]; })) - pc.minY;
    pc.cells.forEach(function (c) { CELLS.push({ pi: pi, x: c[0], y: c[1], w: c[2], h: c[3], fill: c[4] }); });
  });

  levCubes.innerHTML = CELLS.map(function (c) {
    return '<span class="lev-cell" style="width:' + c.w + 'px;height:' + c.h +
           'px;background:' + c.fill + '"></span>';
  }).join("");
  CELLS.forEach(function (c, i) { c.el = levCubes.children[i]; });
  levSec.classList.add("js-lev");

  function seg(x, a, b) { return Math.min(1, Math.max(0, (x - a) / (b - a))); }
  function easeInOut(t) { return t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }
  function lerp(a, b, t) { return a + (b - a) * t; }

  var L = null;

  function measureLevers() {
    levA.style.transform = levB.style.transform = levHy.style.transform = "";
    levCols.forEach(function (c) { c.style.transform = ""; });

    var sr = levStage.getBoundingClientRect();
    var split = window.innerWidth >= 900;
    var aR = levA.getBoundingClientRect(), bR = levB.getBoundingClientRect(), hR = levHy.getBoundingClientRect();
    // the slot fixes the resting size: Brand spans 203x300 units, so an
    // 80x120 slot lands it exactly, and squares every cell up at 40x40
    var ex = 80 / 200, ey = 80 / 200;
    // each row is only as tall as its own tallest piece, so short pieces
    // don't leave a band of dead space above them
    [[0, 3], [3, 6]].forEach(function (rng) {
      var tallest = 0;
      for (var i = rng[0]; i < rng[1]; i++) tallest = Math.max(tallest, PIECES[i].h);
      for (i = rng[0]; i < rng[1]; i++) levSlots[i].style.height = (tallest * ey) + "px";
    });
    var sR = levSlots[0].getBoundingClientRect();

    var fit = (sr.width * .94 - aR.width - bR.width) / (1.18 * CUBE_W);
    var kx = split ? Math.max(ex * 1.2, Math.min(CUBE_PX / CUBE_W, fit))
                   : Math.max(ex * 1.15, Math.min(CUBE_PX / CUBE_W, sr.width / 760));
    var ky = kx;                           // the block is square

    var gap = CUBE_W * kx * 1.18;
    var Sx = sr.width / 2, head = null, cx, cy;

    if (split) {
      var total = aR.width + gap + bR.width, left = Sx - total / 2;
      cx = left + aR.width + gap / 2;
      cy = (aR.top - sr.top) + aR.height / 2;
      head = {
        a:  left + aR.width / 2 - (aR.left - sr.left + aR.width / 2),
        b:  left + aR.width + gap + bR.width / 2 - (bR.left - sr.left + bR.width / 2),
        hy: cx - (hR.left - sr.left + hR.width / 2)
      };
    } else {
      cx = Sx; cy = (aR.top - sr.top) + aR.height / 2;
    }

    var ox = cx - CUBE_W * kx / 2, oy = cy - CUBE_W * ky / 2;

    L = { split: split, kx: kx, ky: ky, ex: ex, ey: ey, head: head,
      anchors: PIECES.map(function (pc, i) {
        var slot = levSlots[i].getBoundingClientRect();
        return {
          from: [ox + pc.minX * kx, oy + pc.minY * ky],
          to:   [slot.left - sr.left, slot.top - sr.top + (slot.height - pc.h * ey)]
        };
      }),
      cells: CELLS.map(function (c) {
        var pc = PIECES[c.pi];
        return { el: c.el, pi: c.pi, dx: c.x - pc.minX, dy: c.y - pc.minY };
      })
    };
  }

  function renderLevers(p) {
    if (!L) return;

    var hj = easeInOut(seg(p, .06, .80));
    if (L.split) {
      levA.style.transform  = "translateX(" + L.head.a  * (1 - hj) + "px)";
      levB.style.transform  = "translateX(" + L.head.b  * (1 - hj) + "px)";
      levHy.style.transform = "translateX(" + L.head.hy * (1 - hj) + "px)";
      levHy.style.opacity   = seg(hj, .62, 1);
    }

    var an = PIECES.map(function (pc, i) {
      var t  = seg(p, .05 + i * .085, .46 + i * .085);
      var tx = easeInOut(seg(t, 0, .6));
      var ty = easeInOut(seg(t, .5, 1));
      var e  = easeInOut(t);
      var a  = L.anchors[i];
      return { x: lerp(a.from[0], a.to[0], tx), y: lerp(a.from[1], a.to[1], ty),
               sx: lerp(L.kx, L.ex, e), sy: lerp(L.ky, L.ey, e) };
    });

    L.cells.forEach(function (c) {
      var a = an[c.pi];
      c.el.style.transform = "translate(" + (a.x + c.dx * a.sx) + "px," +
                                            (a.y + c.dy * a.sy) + "px) scale(" + a.sx + "," + a.sy + ")";
    });

    levEyebrow.style.opacity = easeOut(seg(p, .26, .52));
    levCols.forEach(function (col, i) {
      var t = easeOut(seg(p, .24 + i * .085, .46 + i * .085));
      col.style.opacity = t;
      col.style.transform = "translateY(" + (1 - t) * 14 + "px)";
    });
  }

  var levTicking = false;
  function onLevScroll() {
    if (levTicking) return;
    levTicking = true;
    requestAnimationFrame(function () {
      levTicking = false;
      if (!levTrack.classList.contains("scroll-on")) return;
      var r = levTrack.getBoundingClientRect(), span = r.height - window.innerHeight;
      renderLevers(span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 1);
    });
  }

  function setupLevers() {
    var scrolls = !reduce && window.innerWidth >= 900;
    levTrack.classList.toggle("scroll-on", scrolls);
    measureLevers();
    if (scrolls) onLevScroll(); else renderLevers(1);
  }

  setupLevers();
  window.addEventListener("scroll", onLevScroll, { passive: true });
  window.addEventListener("resize", setupLevers);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(setupLevers);

  /* ── selected work: filter by industry ────────────────────────── */
  var swGrid = document.getElementById("swGrid");
  if (swGrid) {
    var swItems = [].slice.call(swGrid.children);
    var swBtns  = [].slice.call(document.querySelectorAll(".sw-filter"));
    swBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var cat = btn.dataset.cat;
        swBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(b === btn)); });
        swItems.forEach(function (it) { it.hidden = !(cat === "all" || it.dataset.cat === cat); });
      });
    });
  }

  /* ── selected work: the photo travels inside a still frame ─────── */
  if (swGrid) {
    if (!reduce) {
      var swShots = [].slice.call(swGrid.querySelectorAll(".sw-shot"));
      var swTick = false;
      var swDrift = function () {
        if (swTick) return;
        swTick = true;
        requestAnimationFrame(function () {
          swTick = false;
          var vh = window.innerHeight, mid = vh / 2;
          swShots.forEach(function (shot) {
            var r = shot.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            var p = ((r.top + r.height / 2) - mid) / (mid + r.height / 2);
            p = Math.max(-1, Math.min(1, p));
            var img = shot.querySelector("img");
            if (img) img.style.setProperty("--py", (p * r.height * 0.09).toFixed(1) + "px");
          });
        });
      };
      window.addEventListener("scroll", swDrift, { passive: true });
      window.addEventListener("resize", swDrift);
      swDrift();
    }
  }

  /* ── selected work: lenis-style eased drift, one rate per tile ──── */
  var swSec = document.getElementById("work");
  if (swGrid && swSec && !reduce && "requestAnimationFrame" in window) {
    var swTiles = [].slice.call(swGrid.children);
    var SW_RATE = [.045, -.022, .034, -.05, .028, -.038];
    var swCur = swTiles.map(function () { return 0; });
    var swTgt = swCur.slice();
    var swRaf = null;

    var swAim = function () {
      var vh = window.innerHeight, mid = vh / 2;
      swTiles.forEach(function (t, i) {
        var r = t.getBoundingClientRect();
        if (r.bottom < -300 || r.top > vh + 300) return;
        // -1 below the fold, +1 above it
        var p = ((r.top + r.height / 2) - mid) / vh;
        swTgt[i] = -p * vh * SW_RATE[i % SW_RATE.length];
      });
    };

    var swStep = function () {
      swAim();
      swTiles.forEach(function (t, i) {
        var d = swTgt[i] - swCur[i];
        // the lerp is the whole trick: the tile chases the target, never snaps to it
        swCur[i] += Math.abs(d) > .05 ? d * .085 : d;
        t.style.setProperty("--ty", swCur[i].toFixed(2) + "px");
      });
      swRaf = requestAnimationFrame(swStep);
    };

    var swRun = function (on) {
      if (on && swRaf === null) { swRaf = requestAnimationFrame(swStep); }
      else if (!on && swRaf !== null) { cancelAnimationFrame(swRaf); swRaf = null; }
    };

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (e) { swRun(e.isIntersecting && window.innerWidth > 1000); });
      }, { rootMargin: "200px 0px" }).observe(swSec);
    } else { swRun(window.innerWidth > 1000); }

    window.addEventListener("resize", function () {
      if (window.innerWidth <= 1000) {
        swRun(false);
        swTiles.forEach(function (t, i) { swCur[i] = swTgt[i] = 0; t.style.setProperty("--ty", "0px"); });
      }
    });
  }

  /* ── hero: words light on a timer, their block lights with them ─── */
  var hxWords = [].slice.call(document.querySelectorAll(".hx-w"));
  var hxSteps = [].slice.call(document.querySelectorAll(".hx-step"));
  if (hxWords.length && hxSteps.length) {
    var hxAt = -1;
    var hxShow = function (i) {
      hxAt = i;
      hxWords.forEach(function (w, k) { w.classList.toggle("lit", k === i); });
      hxSteps.forEach(function (st) { st.classList.toggle("lit", +st.dataset.g === i); });
    };
    if (reduce) {
      hxSteps.forEach(function (st) { st.classList.add("lit"); });
    } else {
      var hxStair  = document.querySelector(".hx-stair");
      var hxIn     = document.querySelector(".hx-in");
      var hxHero   = document.getElementById("top");
      var hxTimer  = null;
      var hxSeen   = 0;
      var hxHanded = false;      // the hand-off scroll only ever happens once
      var hxState  = "playing";  // playing -> closed -> away -> playing …

      var hxTick = function () {
        hxSeen++;
        if (hxSeen < hxWords.length) { hxShow(hxSeen); return; }
        // all four have had their turn — close the hero
        clearInterval(hxTimer);
        hxTimer = null;
        hxState = "closed";
        hxWords.forEach(function (w) { w.classList.remove("lit"); });
        if (hxIn) hxIn.classList.add("closing");
        if (hxStair) hxStair.classList.add("closed");
        if (!hxHanded) {
          hxHanded = true;
          setTimeout(function () {
            var next = document.getElementById("featured");
            // only take over the scroll if the reader has not moved yet
            if (next && window.scrollY < 20) {
              next.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }, 1100);
        }
      };

      var hxOpenT = null;
      // the words wait for the blocks: 0.75s of travel plus the 0.30s stagger
      var HX_REOPEN = 1080;

      var hxCycle = function () {
        hxSeen = 0;
        hxShow(0);
        clearInterval(hxTimer);
        hxTimer = setInterval(hxTick, 1300);
      };

      var hxStart = function (reopening) {
        hxState = "playing";
        hxSeen = 0;
        clearInterval(hxTimer);
        hxTimer = null;
        clearTimeout(hxOpenT);
        if (hxIn) hxIn.classList.remove("closing");
        if (hxStair) hxStair.classList.remove("closed");
        if (!reopening) { hxCycle(); return; }
        // travel back to the staircase first, unlit, then start from "Marketing"
        hxWords.forEach(function (w) { w.classList.remove("lit"); });
        hxSteps.forEach(function (st) { st.classList.remove("lit"); });
        hxOpenT = setTimeout(hxCycle, HX_REOPEN);
      };

      hxStart(false);

      /* scrolling back up to the hero runs the close in reverse and
         starts the words again from "Marketing" */
      if (hxHero) {
        var hxWatch = false;
        var hxScan = function () {
          if (hxWatch) return;
          hxWatch = true;
          requestAnimationFrame(function () {
            hxWatch = false;
            var vh = window.innerHeight;
            var bottom = hxHero.getBoundingClientRect().bottom;
            if (hxState === "closed" && bottom <= vh * 0.4) { hxState = "away"; return; }
            if (hxState === "away" && bottom >= vh * 0.75) { hxStart(true); }
          });
        };
        window.addEventListener("scroll", hxScan, { passive: true });
        window.addEventListener("resize", hxScan);
      }
    }
  }

  /* ── hero: the menu ───────────────────────────────────────────── */
  var hxMenu = document.getElementById("hxMenu");
  var hxMenuBtn = document.getElementById("hxMenuBtn");
  if (hxMenu && hxMenuBtn) {
    hxMenuBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      var open = hxMenu.classList.toggle("open");
      hxMenuBtn.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", function (e) {
      if (!hxMenu.contains(e.target)) {
        hxMenu.classList.remove("open");
        hxMenuBtn.setAttribute("aria-expanded", "false");
      }
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        hxMenu.classList.remove("open");
        hxMenuBtn.setAttribute("aria-expanded", "false");
      }
    });
  }

  /* ── where you are now: stages open in order, a tetromino per stage ── */
  var wyTrack = document.getElementById("wyTrack");
  var wyList  = document.getElementById("wyList");
  if (wyTrack && wyList) {
    var wyItems = [].slice.call(wyList.children);
    var wyCells = [].slice.call(document.querySelectorAll(".wy-cell"));
    // one tetromino per stage, filling the 4x4 from the bottom up
    var wyPieces = [[10, 12, 13, 14], [6, 7, 11, 15], [4, 5, 8, 9], [0, 1, 2, 3]];
    var wyAt = -1;

    var wySet = function (i) {
      if (i === wyAt) return;
      wyAt = i;
      wyItems.forEach(function (it, k) { it.classList.toggle("on", k === i); });
      var lit = {};
      wyPieces.forEach(function (pc, k) {
        if (k <= i) pc.forEach(function (n) { lit[n] = 1; });
      });
      wyCells.forEach(function (c, k) { c.classList.toggle("lit", !!lit[k]); });
    };
    var wyAll = function () {
      wyAt = -1;
      wyItems.forEach(function (it) { it.classList.add("on"); });
      wyCells.forEach(function (c) { c.classList.add("lit"); });
    };

    if (reduce || !("requestAnimationFrame" in window)) {
      wyAll();
    } else {
      var wyTick = false;
      var wyScan = function () {
        if (wyTick) return;
        wyTick = true;
        requestAnimationFrame(function () {
          wyTick = false;
          if (window.innerWidth < 900) {
            wyTrack.classList.remove("scroll-on");
            wyAll();
            return;
          }
          wyTrack.classList.add("scroll-on");
          var span = wyTrack.offsetHeight - window.innerHeight;
          if (span < 80) { wyAll(); return; }
          var pr = -wyTrack.getBoundingClientRect().top / span;
          pr = pr < 0 ? 0 : pr > 1 ? 1 : pr;
          wySet(Math.min(wyItems.length - 1, Math.floor(pr * wyItems.length)));
        });
      };
      window.addEventListener("scroll", wyScan, { passive: true });
      window.addEventListener("resize", wyScan);
      wyScan();
    }
  }

  /* ── partnership: filter the web ────────────────────────────────── */
  var prStage = document.getElementById("prStage");
  if (prStage) {
    var prNodes = [].slice.call(prStage.querySelectorAll(".pr-node"));
    var prBtns  = [].slice.call(document.querySelectorAll(".pr-filter"));
    prBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var cat = btn.dataset.cat;
        prBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(b === btn)); });
        prStage.classList.toggle("filtered", cat !== "all");
        prNodes.forEach(function (n) { n.classList.toggle("on", n.dataset.cat === cat); });
      });
    });
  }

  /* ── deep dives: one card at a time ─────────────────────────────── */
  var csDeck = document.getElementById("csDeck");
  if (csDeck) {
    var csCards = [].slice.call(csDeck.children);
    var csAt = 0;
    var csGo = function (i) {
      csAt = (i + csCards.length) % csCards.length;
      csCards.forEach(function (c, k) { c.classList.toggle("on", k === csAt); });
    };
    var csPrev = document.getElementById("csPrev");
    var csNext = document.getElementById("csNext");
    if (csPrev) csPrev.addEventListener("click", function () { csGo(csAt - 1); });
    if (csNext) csNext.addEventListener("click", function () { csGo(csAt + 1); });
  }

  /* ── scroll reveal ────────────────────────────────────────────── */
  var io = "IntersectionObserver" in window ? new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
    });
  }, { rootMargin: "0px 0px -12% 0px" })
    : { observe: function (el) { el.classList.add("in"); }, unobserve: function () {} };
  document.querySelectorAll(".rv, .wm").forEach(function (el) { io.observe(el); });

  /* ── featured work: the first row sits open; hover moves it ─────── */
  var fwRows = [].slice.call(document.querySelectorAll(".fw-row"));
  if (fwRows.length) {
    var fwOpen = function (row) {
      fwRows.forEach(function (r) { r.classList.toggle("is-open", r === row); });
    };
    fwOpen(fwRows[0]);
    fwRows.forEach(function (r) {
      r.addEventListener("mouseenter", function () { fwOpen(r); });
      r.addEventListener("focus", function () { fwOpen(r); });
    });
    var fwList = document.querySelector(".fw-list");
    if (fwList) {
      fwList.addEventListener("mouseleave", function () { fwOpen(fwRows[0]); });
    }
  }

  /* ── footer: the assembly plays once, when it comes into view ───── */
  document.querySelectorAll(".vfoot").forEach(function (el) {
    if (!("IntersectionObserver" in window)) { el.classList.add("is-playing"); return; }
    new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-playing");
        obs.unobserve(entry.target);
      });
    }, { threshold: 0.35 }).observe(el);
  });

})();
</script>
</body>
</html>
