<!-- ══ CASE STUDIES ══ -->
<section class="cs" id="deepdive">

  <div class="cs-deco" aria-hidden="true">
    <span class="cs-blk" style="left:86.458%;top:0"></span>
    <span class="cs-blk" style="left:calc(86.458% + 72 * var(--k));top:0"></span>
    <span class="cs-blk" style="left:calc(86.458% + 72 * var(--k));top:calc(72 * var(--k))"></span>
    <span class="cs-blk" style="left:3.611%;top:calc(728 * var(--k))"></span>
    <span class="cs-blk" style="left:calc(3.611% + 72 * var(--k));top:calc(728 * var(--k))"></span>
    <span class="cs-blk" style="left:calc(3.611% + 144 * var(--k));top:calc(728 * var(--k))"></span>
